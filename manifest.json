{
  "plugin_id": "xy_media",
  "name": "屏幕截屏、录屏与多媒体 (Media & Capture)",
  "version": "0.53.0",
  "group": "Media",
  "group_icon": "🎬",
  "description": "工业级桌面跨平台多媒体处理套件。覆盖通用截图、长图拼接、USB相机与RTSP抓拍、GIF/MP4录屏、双声道混音内录、Whisper AI ASR/TTS语音交互及打码脱敏",
  "actions": [
    {
      "tag": "CaptureImage",
      "display_name": "通用画面截图 (CaptureImage)",
      "icon": "📸",
      "platforms": "All",
      "requires_admin": false,
      "description": "聚合型图像捕获动作，支持全屏、前台/句柄指定窗口及绝对坐标区域 (ROI) 裁切，内置 OCR 视觉白底平铺优化",
      "keywords": [
        "media",
        "capture",
        "image",
        "screenshot",
        "截图",
        "截屏",
        "窗口截图",
        "区域截图"
      ],
      "fields": [
        {
          "name": "capture_type",
          "display_name": "截图模式",
          "intrinsic_type": "String",
          "required": true,
          "group": "截图模式",
          "default_type": "string",
          "default_value": "Screen",
          "presets": ["Screen", "Window", "ActiveWindow", "Region"],
          "description": "截图类型模式"
        },
        {
          "name": "window",
          "display_name": "目标窗口",
          "intrinsic_type": "wnd",
          "group": "目标指定",
          "visible_if": {
            "field": "capture_type",
            "one_of": ["Window", "ActiveWindow"]
          },
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "目标窗口标题或句柄表达式"
        },
        {
          "name": "display_name",
          "display_name": "显示器",
          "intrinsic_type": "String",
          "group": "目标指定",
          "visible_if": {
            "field": "capture_type",
            "one_of": ["Screen"]
          },
          "default_type": "string",
          "default_value": "primary",
          "presets": ["primary", "0", "1"],
          "description": "显示器编号或 primary"
        },
        {
          "name": "top_left",
          "display_name": "左上角偏移 (X, Y)",
          "intrinsic_type": "point",
          "group": "区域裁剪",
          "visible_if": {
            "field": "capture_type",
            "one_of": ["Region"]
          },
          "default_type": "string",
          "default_value": "0, 0",
          "presets": ["0, 0"],
          "description": "裁剪起始坐标"
        },
        {
          "name": "size",
          "display_name": "截取尺寸 (W, H)",
          "intrinsic_type": "size",
          "group": "区域裁剪",
          "visible_if": {
            "field": "capture_type",
            "one_of": ["Region"]
          },
          "default_type": "string",
          "default_value": "",
          "presets": ["", "1920, 1080"],
          "description": "截取分辨率尺寸"
        },
        {
          "name": "output_path",
          "display_name": "保存文件路径",
          "intrinsic_type": "filepicker",
          "group": "输出规则",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "留空存入内存变量 Image"
        },
        {
          "name": "to_clipboard",
          "display_name": "写入剪贴板",
          "intrinsic_type": "bool",
          "group": "输出规则",
          "default_type": "number",
          "default_value": "0",
          "presets": ["0", "1"],
          "description": "是否拷贝到系统剪贴板"
        },
        {
          "name": "ocr_optimize",
          "display_name": "OCR白底优化",
          "intrinsic_type": "bool",
          "group": "高级视觉",
          "is_advanced": true,
          "default_type": "number",
          "default_value": "0",
          "presets": ["0", "1"],
          "description": "透明通道铺平为纯白底色"
        }
      ]
    },
    {
      "tag": "CaptureScroll",
      "display_name": "滚动截取长图 (CaptureScroll)",
      "icon": "📜",
      "platforms": "All",
      "requires_admin": false,
      "description": "自动模拟滚轮滚动窗口或网页，智能检测末尾停顿并缝合拼接生成超长分辨率全貌截图",
      "keywords": [
        "media",
