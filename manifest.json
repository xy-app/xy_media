{
  "plugin_id": "xy_media",
  "name": "屏幕截屏、录屏与多媒体 (Media & Capture)",
  "version": "0.51.0",
  "group": "Media",
  "group_icon": "🎬",
  "description": "提供屏幕截图、滚动长截图、桌面录制为 GIF 动图、音频播放与录音、提示音以及工业摄像头采图功能",
  "actions": [
    {
      "tag": "AudioPlay",
      "display_name": "播放音频 (AudioPlay)",
      "icon": "▶️",
      "platforms": "All",
      "requires_admin": false,
      "description": "播放本地音频文件 (如 MP3、WAV 等)，支持调节音量和循环播放",
      "keywords": [
        "media",
        "audio",
        "play",
        "sound",
        "mp3",
        "wav",
        "播放音频",
        "播放声音",
        "提示音",
        "背景音乐"
      ],
      "fields": [
        {
          "name": "file_path",
          "display_name": "音频文件路径",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [
            "C:/audio/notification.wav",
            "C:/music/bgm.mp3"
          ],
          "description": "本地音频文件的绝对路径或相对路径"
        },
        {
          "name": "volume",
          "display_name": "音量 (0 - 100)",
          "intrinsic_type": "number",
          "default_type": "number",
          "default_value": "80",
          "presets": [
            "50",
            "80",
            "100"
          ],
          "description": "音频播放音量大小 (0-100)"
        },
        {
          "name": "repeat",
          "display_name": "循环播放",
          "intrinsic_type": "number",
          "default_type": "number",
          "default_value": "0",
          "presets": [
            "0",
            "1"
          ],
          "description": "是否开启循环重复播放 (1 为开启，0 为单次)"
        },
        {
          "name": "wait",
          "display_name": "等待播放完成",
          "intrinsic_type": "number",
          "default_type": "number",
          "default_value": "0",
          "presets": [
            "0",
            "1"
          ],
          "description": "是否同步阻塞直到音频播放结束 (1 为阻塞，0 为后台播放)"
        }
      ],
      "output_type": "string"
    },
    {
      "tag": "AudioRecord",
      "display_name": "录音到文件 (AudioRecord)",
      "icon": "🎙️",
      "platforms": "All",
      "requires_admin": false,
      "description": "通过麦克风录制声音并保存为高质量音频文件",
      "keywords": [
        "media",
        "audio",
        "record",
        "mic",
        "wav",
        "录音",
        "麦克风录音",
        "语音录入",
        "音频录制"
      ],
      "fields": [
        {
          "name": "action",
          "display_name": "录制模式",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "record_duration",
          "presets": [
            "record_duration",
            "start",
            "stop"
          ],
          "description": "录制动作模式：record_duration (指定时长录制)、start (后台启动录音)、stop (停止录音并保存)"
        },
        {
          "name": "output_path",
          "display_name": "WAV保存路径",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "recording.wav",
          "presets": [
            "recording.wav",
            "C:/temp/voice.wav"
          ],
          "description": "录音文件保存的完整路径 (仅限 .wav 格式)"
        },
        {
          "name": "duration",
          "display_name": "录音时长(秒)",
          "intrinsic_type": "number",
          "default_type": "number",
          "default_value": "5",
          "presets": [
            "3",
            "5",
            "10",
            "30"
          ],
          "description": "在 record_duration 模式下的录音持续时间 (秒)"
        },
        {
          "name": "sample_rate",
          "display_name": "音频采样率(Hz)",
          "intrinsic_type": "number",
          "default_type": "number",
          "default_value": "16000",
          "presets": [
            "8000",
            "16000",
            "44100"
          ],
          "description": "音频采样率频率 (语音识别建议 16000 Hz)"
        }
      ],
      "output_type": "string"
    },
    {
      "tag": "AudioStop",
      "display_name": "停止音频 (AudioStop)",
      "icon": "⏹️",
      "platforms": "All",
      "requires_admin": false,
      "description": "立即停止正在播放的背景音乐或提示音",
