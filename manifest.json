        "滚动截图",
        "网页长截图"
      ],
      "fields": [
        {
          "name": "target_window",
          "display_name": "目标窗口",
          "intrinsic_type": "wnd",
          "group": "目标与方向",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "目标窗口或句柄"
        },
        {
          "name": "scroll_direction",
          "display_name": "滚动方向",
          "intrinsic_type": "String",
          "group": "目标与方向",
          "default_type": "string",
          "default_value": "down",
          "presets": ["down", "up"],
          "description": "滚轮步进方向"
        },
        {
          "name": "scroll_clicks",
          "display_name": "单次滚轮步长",
          "intrinsic_type": "number",
          "group": "滚动步长",
          "default_type": "number",
          "default_value": "5",
          "presets": ["3", "5", "8"],
          "description": "滚轮刻度"
        },
        {
          "name": "max_pages",
          "display_name": "最大滚动页数",
          "intrinsic_type": "number",
          "group": "滚动步长",
          "default_type": "number",
          "default_value": "5",
          "presets": ["3", "5", "10"],
          "description": "允许拼接的最大页数"
        },
        {
          "name": "delay_ms",
          "display_name": "滚动间歇(ms)",
          "intrinsic_type": "number",
          "group": "缝合控制",
          "default_type": "number",
          "default_value": "400",
          "presets": ["300", "400", "600"],
          "description": "页面沉降延时"
        },
        {
          "name": "overlap_pct",
          "display_name": "重叠比例(%)",
          "intrinsic_type": "number",
          "group": "缝合控制",
          "default_type": "number",
          "default_value": "20",
          "presets": ["10", "20", "30"],
          "description": "重叠融合估算比例"
        },
        {
          "name": "output_path",
          "display_name": "保存文件路径",
          "intrinsic_type": "filepicker",
          "group": "输出规则",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "长图保存路径"
        },
        {
          "name": "to_clipboard",
          "display_name": "写入剪贴板",
          "intrinsic_type": "bool",
          "group": "输出规则",
          "default_type": "number",
          "default_value": "0",
          "presets": ["0", "1"],
          "description": "写入剪贴板"
        },
        {
          "name": "ocr_optimize",
          "display_name": "OCR白底优化",
          "intrinsic_type": "bool",
          "group": "高级视觉",
          "is_advanced": true,
          "default_type": "number",
          "default_value": "0",
          "presets": ["0", "1"],
          "description": "白底平铺优化"
        }
      ]
    },
    {
