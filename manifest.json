          "presets": [
            "",
            "xy_audio",
            "bgm"
          ],
          "description": "待停止的音频通道别名，留空停止默认通道"
        }
      ],
      "output_type": "string"
    },
    {
      "tag": "CameraClose",
      "display_name": "关闭相机设备 (CameraClose)",
      "icon": "📷",
